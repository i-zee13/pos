# Copy to remote-db.env and fill values:
#   cp scripts/remote-db.env.example scripts/remote-db.env
#
# remote-db.env gitignore mein hai — secrets commit nahi hongi.

SSH_HOST=premium188.web-hosting.com
SSH_PORT=21098
SSH_USER=dottbfyw
SSH_PASS=CHANGE_ME

# Target DB (pehle se created hona chahiye — script create nahi karti)
DB_NAME=dottbfyw_shamastore
DB_USER=dottbfyw_shamastore
DB_PASS=CHANGE_ME

# Mac pe dumps yahan se uthengi (sirf filename command mein doge)
DOWNLOADS_DIR=~/Downloads

# Server pe upload folder (default home)
REMOTE_DIR='~'

# Optional: HTTP pull via scripts/server-dropins/db-export.php
# (upload with: ./scripts/upload-db-export.php.sh)
# EXPORT_URL=https://your-domain.com/db-export.php
# EXPORT_TOKEN=long-random-secret
